// muMAG SP4, field 1. Parameters follow NIST; initialization follows MuMax3.
nx := 128
ny := 32
nz := 1
SetGridSize(nx, ny, nz)
SetCellSize(500e-9/nx, 125e-9/ny, 3e-9/nz)
Msat = 800e3
Aex = 13e-12
Ku1 = 0
alpha = 0.02
MaxErr = 1e-6
B_ext = Vector(0, 0, 0)
m = Uniform(1, 0.1, 0)
Relax()
SaveAs(m, "m_initial.ovf")

// For field 2, use (-35.5e-3, -6.3e-3, 0) in a fresh independent run.
B_ext = Vector(-24.6e-3, 4.3e-3, 0)
samplePeriod := 1e-12
nSamples := 1000
crossingTime := -1.0
mx := m.Comp(0)
TableAdd(B_ext)
TableAdd(E_total)
TableAddVar(samplePeriod, "sample_s", "s")
TableAddVar(nSamples*samplePeriod, "observe_s", "s")
TableAddVar(crossingTime, "crossing_time_s", "s")
SetSolver(4)
FixDt = samplePeriod/10
TableSave()
for i:=0; i<nSamples; i++{
    Steps(10)
    if crossingTime < 0 && mx.Average() <= 0 {
        crossingTime = t
        SaveAs(m, "m_crossing.ovf")
    }
    TableSave()
}
SaveAs(m, "m_final.ovf")
